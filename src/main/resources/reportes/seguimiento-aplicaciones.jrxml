	</variable>
	<variable name="SumTotal" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{total}]]></expression>
	</variable>
	<variable name="SumHoras" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{hhAprobadas}]]></expression>
	</variable>

