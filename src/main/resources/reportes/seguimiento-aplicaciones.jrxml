<!-- Subreporte de seguimiento.jrxml: resumen por aplicación con % del total y fila de totales.
     Una fila por aplicación (mapas con las claves de los fields). -->
<jasperReport name="SeguimientoAplicaciones" pageWidth="515" pageHeight="842" columnWidth="515" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="c304fc47-8ff5-4f89-9e62-01f1ca44086c">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="8.0" forecolor="#1E293B"/>
	<style name="Cabecera" fontName="DejaVu Sans" fontSize="8.0" bold="true" forecolor="#FFFFFF" backcolor="#0F2647" mode="Opaque">
		<box leftPadding="5" rightPadding="5"/>
	</style>
	<style name="Fila" fontName="DejaVu Sans" fontSize="8.0" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle backcolor="#F1F5F9">
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
		</conditionalStyle>
		<box leftPadding="5" rightPadding="5">
			<bottomPen lineWidth="0.5" lineColor="#E2E8F0"/>
		</box>
	</style>
	<style name="Total" fontName="DejaVu Sans" fontSize="8.0" bold="true" mode="Opaque" backcolor="#E2E8F0">
		<box leftPadding="5" rightPadding="5"/>
	</style>

	<field name="codigo" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="registrados" class="java.lang.Long"/>
	<field name="estimados" class="java.lang.Long"/>
	<field name="aprobados" class="java.lang.Long"/>
	<field name="rechazados" class="java.lang.Long"/>
	<field name="total" class="java.lang.Long"/>
	<field name="porcentaje" class="java.lang.Double"/>
	<field name="hhAprobadas" class="java.math.BigDecimal"/>

	<variable name="SumRegistrados" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{registrados}]]></expression>
	</variable>
	<variable name="SumEstimados" calculation="Sum" class="java.lang.Long">
