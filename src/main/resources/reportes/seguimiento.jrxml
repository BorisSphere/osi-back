<!-- Reporte de seguimiento de requerimientos (RF08). Formato JasperReports 7.
     Página 1: encabezado, filtros, indicadores, gráficos y resumen por aplicación (subreporte).
     Detalle (datos principales): un requerimiento por fila (anexo), con filas alternadas.
     Todos los números salen de TableroService, igual que la pantalla de Reportes. -->
<jasperReport name="SeguimientoRequerimientos" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="36" whenNoDataType="AllSectionsNoDetail" uuid="aca36164-b52c-4956-a489-4ac46674b8bd">
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
	<property name="net.sf.jasperreports.export.xls.sheet.names.all" value="Seguimiento"/>
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="8.0" forecolor="#1E293B"/>
	<style name="Cabecera" fontName="DejaVu Sans" fontSize="8.0" bold="true" forecolor="#FFFFFF" backcolor="#0F2647" mode="Opaque">
		<box leftPadding="5" rightPadding="5"/>
	</style>
	<style name="Fila" fontName="DejaVu Sans" fontSize="8.0" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle backcolor="#F1F5F9">
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
		</conditionalStyle>
		<box leftPadding="5" rightPadding="5">
			<bottomPen lineWidth="0.5" lineColor="#E2E8F0"/>
		</box>
	</style>
	<style name="Seccion" fontName="DejaVu Sans" fontSize="11.0" bold="true" forecolor="#0F2647"/>

	<dataset name="Estados" uuid="6c619a9f-af98-4afd-b90a-5cf18cdbd1ab">
		<field name="estado" class="java.lang.String"/>
		<field name="cantidad" class="java.lang.Long"/>
	</dataset>
	<dataset name="HorasPorAplicacion" uuid="931aa225-bee8-44d1-a43d-b44ca3f8ef29">
		<field name="aplicacion" class="java.lang.String"/>
		<field name="horas" class="java.math.BigDecimal"/>
	</dataset>

	<parameter name="FILTROS" class="java.lang.String"/>
	<parameter name="GENERADO_POR" class="java.lang.String"/>
	<parameter name="FECHA_GENERACION" class="java.lang.String"/>
	<parameter name="TOTAL" class="java.lang.Long"/>
	<parameter name="TOTAL_REGISTRADOS" class="java.lang.Long"/>
	<parameter name="TOTAL_ESTIMADOS" class="java.lang.Long"/>
	<parameter name="TOTAL_APROBADOS" class="java.lang.Long"/>
	<parameter name="TOTAL_RECHAZADOS" class="java.lang.Long"/>
	<parameter name="TOTAL_HH_APROBADAS" class="java.math.BigDecimal"/>
	<parameter name="HAY_HORAS" class="java.lang.Boolean"/>
	<parameter name="ESTADOS_DS" class="net.sf.jasperreports.engine.JRDataSource"/>
	<parameter name="HORAS_DS" class="net.sf.jasperreports.engine.JRDataSource"/>
	<parameter name="APLICACIONES_DS" class="net.sf.jasperreports.engine.JRDataSource"/>
	<parameter name="APLICACIONES_REPORT" class="net.sf.jasperreports.engine.JasperReport"/>

	<field name="codigo" class="java.lang.String"/>
	<field name="titulo" class="java.lang.String"/>
	<field name="aplicacion" class="java.lang.String"/>
	<field name="prioridad" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="hhTotal" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.lang.String"/>

	<title height="470">
		<!-- Banda institucional -->
		<element kind="staticText" uuid="0a4e1eab-7fe9-45a4-b5bc-c38d924845c6" mode="Opaque" x="0" y="0" width="515" height="18" backcolor="#0F2647" forecolor="#93C5FD" fontSize="7.5" bold="true" vTextAlign="Bottom">
			<text><![CDATA[⚙  LAB MODERNIZACIÓN · GESTIÓN DE REQUERIMIENTOS DE MODERNIZACIÓN TECNOLÓGICA]]></text>
			<box leftPadding="12"/>
		</element>
		<element kind="staticText" uuid="cdcd5100-c419-459b-ae00-6d84bcdb46e1" mode="Opaque" x="0" y="18" width="515" height="34" backcolor="#0F2647" forecolor="#FFFFFF" fontSize="17.0" bold="true" vTextAlign="Middle">
			<text><![CDATA[Reporte de seguimiento de requerimientos]]></text>
			<box leftPadding="12"/>
		</element>
		<!-- Filtros -->
		<element kind="textField" uuid="7aa7310f-16c2-497b-8e7b-f49c685a1702" mode="Opaque" x="0" y="58" width="515" height="16" backcolor="#F1F5F9" forecolor="#1E293B" vTextAlign="Middle" bold="true">
			<expression><![CDATA["Filtros:  " + $P{FILTROS}]]></expression>
			<box leftPadding="12"/>
		</element>
		<element kind="textField" uuid="78e4acaa-b25b-4944-aa63-49a95a152382" mode="Opaque" x="0" y="74" width="515" height="16" backcolor="#F1F5F9" forecolor="#475569" vTextAlign="Middle">
			<expression><![CDATA["Generado por " + $P{GENERADO_POR} + " el " + $P{FECHA_GENERACION}]]></expression>
			<box leftPadding="12"/>
		</element>

		<!-- Indicadores (6 tarjetas pegadas: así el Excel no genera columnas vacías entre ellas) -->
		<element kind="staticText" uuid="84fc6f3c-ad70-4875-af05-8adbc9b4fd9b" mode="Opaque" x="0" y="98" width="86" height="16" backcolor="#E2E8F0" forecolor="#475569" hTextAlign="Center" vTextAlign="Middle" fontSize="7.5">
