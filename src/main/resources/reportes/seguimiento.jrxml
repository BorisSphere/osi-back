			<dataSourceExpression><![CDATA[$P{APLICACIONES_DS}]]></dataSourceExpression>
			<expression><![CDATA[$P{APLICACIONES_REPORT}]]></expression>
		</element>

		<!-- Título del anexo: flota debajo del resumen si este crece -->
		<element kind="staticText" uuid="302602e2-18e0-49a6-a97d-640be52bf840" positionType="Float" x="0" y="430" width="515" height="18" style="Seccion">
			<text><![CDATA[Detalle de requerimientos]]></text>
		</element>
		<element kind="textField" uuid="1236dc3f-10e9-4d00-af74-a56aa2b7cb52" positionType="Float" x="0" y="448" width="515" height="16" forecolor="#475569">
			<expression><![CDATA[$P{TOTAL} + ($P{TOTAL} == 1 ? " requerimiento" : " requerimientos") + " en el período, ordenados por aplicación."]]></expression>
		</element>
	</title>

