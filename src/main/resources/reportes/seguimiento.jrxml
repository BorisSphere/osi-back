			<text><![CDATA[HH aprobadas]]></text>
		</element>
		<element kind="textField" uuid="d1062569-c09d-40ad-9712-ffb1f7fb9cc9" mode="Opaque" x="0" y="114" width="86" height="30" backcolor="#E2E8F0" hTextAlign="Center" vTextAlign="Middle" fontSize="16.0" bold="true">
			<expression><![CDATA[$P{TOTAL}]]></expression>
		</element>
		<element kind="textField" uuid="1c10fd8c-f865-41f2-a490-7c4adf8caa32" mode="Opaque" x="86" y="114" width="86" height="30" backcolor="#DBEAFE" forecolor="#1D4ED8" hTextAlign="Center" vTextAlign="Middle" fontSize="16.0" bold="true">
			<expression><![CDATA[$P{TOTAL_REGISTRADOS}]]></expression>
		</element>
		<element kind="textField" uuid="85d3f064-0322-477f-8b1c-f906bbebd500" mode="Opaque" x="172" y="114" width="86" height="30" backcolor="#FEF3C7" forecolor="#B45309" hTextAlign="Center" vTextAlign="Middle" fontSize="16.0" bold="true">
			<expression><![CDATA[$P{TOTAL_ESTIMADOS}]]></expression>
		</element>
		<element kind="textField" uuid="a600f792-2d7e-4213-82d8-103642c8d306" mode="Opaque" x="258" y="114" width="86" height="30" backcolor="#DCFCE7" forecolor="#15803D" hTextAlign="Center" vTextAlign="Middle" fontSize="16.0" bold="true">
			<expression><![CDATA[$P{TOTAL_APROBADOS}]]></expression>
		</element>
		<element kind="textField" uuid="d5042145-e310-452b-9ed9-adaf4b64d16a" mode="Opaque" x="344" y="114" width="86" height="30" backcolor="#FEE2E2" forecolor="#B91C1C" hTextAlign="Center" vTextAlign="Middle" fontSize="16.0" bold="true">
			<expression><![CDATA[$P{TOTAL_RECHAZADOS}]]></expression>
		</element>
		<element kind="textField" uuid="d3241b16-bbd5-4067-aaa4-897c20c922fe" mode="Opaque" x="430" y="114" width="85" height="30" backcolor="#0F2647" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle" fontSize="14.0" bold="true" pattern="#,##0.00">
			<expression><![CDATA[$P{TOTAL_HH_APROBADAS}]]></expression>
		</element>

		<!-- Gráficos -->
		<element kind="staticText" uuid="fead642c-1999-4a2b-ac6c-5145333a5529" x="0" y="156" width="252" height="16" style="Seccion">
			<text><![CDATA[Requerimientos por estado]]></text>
		</element>
		<element kind="staticText" uuid="703419de-52d7-42f4-91e9-9e4556d1b322" x="263" y="156" width="252" height="16" style="Seccion">
			<text><![CDATA[HH aprobadas por aplicación]]></text>
		</element>
		<element kind="chart" chartType="bar" uuid="a6bd58fe-033c-4aa5-b435-eddce5c52740" x="0" y="174" width="252" height="170" customizerClass="com.osinergmin.osinergmin.reportes.GraficoEstadosCustomizer">
			<printWhenExpression><![CDATA[$P{TOTAL} > 0]]></printWhenExpression>
			<dataset kind="category">
				<datasetRun uuid="7ab94ef2-1ee1-405d-842a-a0a128aea91b" subDataset="Estados">
					<dataSourceExpression><![CDATA[$P{ESTADOS_DS}]]></dataSourceExpression>
				</datasetRun>
				<series>
					<seriesExpression><![CDATA["Requerimientos"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{estado}]]></categoryExpression>
					<valueExpression><![CDATA[$F{cantidad}]]></valueExpression>
				</series>
			</dataset>
			<plot/>
		</element>
		<element kind="staticText" uuid="dbfe919f-6eb8-4964-bbbb-ee394a2638c3" x="0" y="174" width="252" height="30" forecolor="#475569" italic="true" vTextAlign="Middle">
			<printWhenExpression><![CDATA[$P{TOTAL} == 0]]></printWhenExpression>
			<text><![CDATA[Sin requerimientos en el período.]]></text>
		</element>
		<element kind="chart" chartType="bar" uuid="4e84023b-7a08-4ffe-a589-07e0534ed1b4" x="263" y="174" width="252" height="170" customizerClass="com.osinergmin.osinergmin.reportes.GraficoHorasCustomizer">
			<printWhenExpression><![CDATA[$P{HAY_HORAS}]]></printWhenExpression>
			<dataset kind="category">
				<datasetRun uuid="9fe2a8d9-b97d-41a2-a238-18c3a56f97d8" subDataset="HorasPorAplicacion">
					<dataSourceExpression><![CDATA[$P{HORAS_DS}]]></dataSourceExpression>
				</datasetRun>
				<series>
					<seriesExpression><![CDATA["HH aprobadas"]]></seriesExpression>
					<categoryExpression><![CDATA[$F{aplicacion}]]></categoryExpression>
					<valueExpression><![CDATA[$F{horas}]]></valueExpression>
				</series>
			</dataset>
			<plot/>
		</element>
		<element kind="staticText" uuid="ba094a48-8250-4551-a54d-faf7ebbaa3d1" x="263" y="174" width="252" height="30" forecolor="#475569" italic="true" vTextAlign="Middle">
			<printWhenExpression><![CDATA[!$P{HAY_HORAS}]]></printWhenExpression>
			<text><![CDATA[Sin horas aprobadas en el período.]]></text>
		</element>

		<!-- Resumen por aplicación (subreporte: puede crecer hacia abajo) -->
		<element kind="staticText" uuid="be9d79f8-47fb-4701-8250-04fc761fb815" x="0" y="356" width="515" height="18" style="Seccion">
